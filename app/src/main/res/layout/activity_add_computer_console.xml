<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070D"
    android:orientation="horizontal">

    <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.94" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.06"
        android:background="#1D1933"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="42dp"
        android:paddingEnd="34dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOONLIGHT"
            android:textColor="#B9ADD8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/manuallyAddPcText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add streaming host"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enter the host name or IP address. Moonlight will verify and save it."
            android:textColor="#C9C2DA"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/hostTextView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#7B68AE"
            android:hint="Host name or IP address"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#9F96B5"
            android:textSize="17sp">

            <requestFocus />
        </EditText>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancelAddPcButton"
                android:layout_width="200dp"
                android:layout_height="56dp"
                android:backgroundTint="#30284D"
                android:text="Cancel"
                android:textColor="#F6F1FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/addPcButton"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="#5B3FA0"
                android:text="Add host"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="BACK · CANCEL"
            android:textColor="#9F96B5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
